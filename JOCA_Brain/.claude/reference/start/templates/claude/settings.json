{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-main.sh",
            "timeout": 10,
            "statusMessage": "A verificar a branch..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/avisar-design.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
