node_modules/
dist/
.DS_Store
*.log
.env
.env.*
package-lock.json
# JOCA OS installs with `npm ci`: its locks must be committed.
!JOCA_OS/backend/package-lock.json
!JOCA_OS/frontend/package-lock.json
# Runtime + personal state (projects, settings, tasks, automations).
# Local-only per machine — never commit. Mirrors JOCA_OS/.gitignore.
JOCA_OS/data/
JOCA_OS/backend/data/
JOCA_Brain/temp_audio/
rename-to-brain.bat
# Local per-machine Claude Code settings (permissions, local overrides) — never commit.
# Do NOT rely on a global gitignore for this: it must be enforced by the repo itself.
**/.claude/settings.local.json
# Escolha local de modelo/effort por agente (modelos-agentes.mjs --aplicar) — por máquina, nunca no repo.
**/.claude/modelos-agentes.local.json
.claude/scheduled_tasks.lock
**/.playwright-mcp/

# GIFs do tema The Office — obra de terceiros, ficam locais (ver LEIA-ME dentro da pasta)
JOCA_OS/frontend/public/brand/office/*
!JOCA_OS/frontend/public/brand/office/LEIA-ME.txt
